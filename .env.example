# Copia questo file in .env e incolla i valori dalla console Firebase
# (Impostazioni progetto > Le tue app > App web > Configurazione SDK).
VITE_FIREBASE_API_KEY=
# Per il sito pubblicato: lo stesso indirizzo del sito (whos-next.web.app), vedi GUIDA-FIREBASE.md
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Domini email della scuola ammessi al login (facoltativi: questi sono già i valori predefiniti).
VITE_DOMINIO_STUDENTI=studenti.ittsrimini.edu.it
VITE_DOMINIO_DOCENTI=ittsrimini.edu.it

# Notifiche push (Firebase → Impostazioni progetto → Cloud Messaging → Certificati push web → "Coppia di chiavi")
VITE_FIREBASE_VAPID_KEY=
# Indirizzo delle funzioni su Netlify (es. https://whosnext-server.netlify.app/api/notifica)
VITE_URL_NOTIFICHE=
