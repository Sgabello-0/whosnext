# Copia questo file in .env e incolla i valori dalla console Firebase
# (Impostazioni progetto > Le tue app > App web > Configurazione SDK).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio email della scuola ammesso al login.
VITE_DOMINIO_SCUOLA=studenti.ittsrimini.edu.it
