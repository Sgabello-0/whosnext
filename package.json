{
  "name": "whosnext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WhosNext",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "firebase emulators:exec --only firestore --project demo-whosnext \"vitest run --config vitest.server.config.ts\"",
    "test:regole": "firebase emulators:exec --only firestore --project demo-whosnext \"vitest run --config vitest.rules.config.ts\"",
    "dev:emu": "firebase emulators:exec --only auth,firestore --project demo-whosnext --ui \"vite --mode emulator\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-whosnext \"playwright test\"",
    "deploy:regole": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:sito": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "jose": "6.2.15",
    "lucide-react": "^1.67.0",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@netlify/functions": "^6.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
