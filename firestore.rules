rules_version = '2';

// Regole di sicurezza di "WhosNext".
// Tutto ciò che non è esplicitamente permesso è vietato.
// I domini della scuola sono gli stessi di src/lib/domain.ts (DOMINI_DEFAULT).

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Identità ─────────────

    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function emailMinuscola() {
      return request.auth.token.email.lower();
    }
    // matches() confronta l'intera stringa: niente sottodomini o suffissi.
    function isStudente() {
      return signedIn() && emailMinuscola().matches('[^@\\s]+@studenti[.]ittsrimini[.]edu[.]it');
    }
    function isDocente() {
      return signedIn() && emailMinuscola().matches('[^@\\s]+@ittsrimini[.]edu[.]it');
    }
    function isScuola() {
      return isStudente() || isDocente();
    }
    // Il tipo di account dipende solo dal dominio: non si può scegliere.
    function tipoAccount() {
      return isStudente() ? 'studente' : 'docente';
    }

    // ───────────── Percorsi e ruoli ─────────────

    function classePath(c) {
      return /databases/$(database)/documents/classes/$(c);
    }
    function membroPath(c, u) {
      return /databases/$(database)/documents/classes/$(c)/members/$(u);
    }
    function invitoPath(codice) {
      return /databases/$(database)/documents/invites/$(codice);
    }
    function interrogazionePath(c, s, i) {
      return /databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i);
    }
    function dsaPath(c, u) {
      return /databases/$(database)/documents/classes/$(c)/dsa/$(u);
    }

    function isMembro(c) {
      return isScuola() && exists(membroPath(c, request.auth.uid));
    }
    function mioRuolo(c) {
      return get(membroPath(c, request.auth.uid)).data.ruolo;
    }
    function isCapo(c) {
      return isMembro(c) && get(classePath(c)).data.capoclasseUid == request.auth.uid;
    }
    function isCapoOVice(c) {
      return isMembro(c) && mioRuolo(c) in ['capo', 'vice'];
    }
    // Capo, vice e docenti con il permesso del capoclasse modificano le liste.
    function puoModificareListe(c) {
      return isMembro(c) && (
        mioRuolo(c) in ['capo', 'vice']
        || (mioRuolo(c) == 'docente' && get(membroPath(c, request.auth.uid)).data.permessoModifica == true)
      );
    }
    // Il capoclasse sta eliminando la classe: nello stesso batch il documento della classe sparisce.
    function eliminazioneClasse(c) {
      return isCapo(c) && !existsAfter(classePath(c));
    }

    // ───────────── Validazioni ─────────────

    function testo(v, max) {
      return v is string && v.size() >= 1 && v.size() <= max;
    }
    function fotoValida(v) {
      return v == null || (v is string && v.size() <= 2048);
    }
    function codiceValido(codice) {
      return codice is string && codice.matches('[A-Z2-9]{6}');
    }
    function dataISO(v) {
      return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    // Giorni della settimana con lezione: 0 = lunedì … 5 = sabato
    function giorniLezione(v) {
      return v is list && v.size() <= 6 && v.hasOnly([0, 1, 2, 3, 4, 5]);
    }

    // ───────────── Utenti ─────────────

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if isScuola() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'foto', 'tipo', 'impostazioni', 'creato', 'aggiornato'])
        && testo(request.resource.data.nome, 100)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.tipo == tipoAccount()
        && fotoValida(request.resource.data.get('foto', null))
        && request.resource.data.impostazioni is map;
      allow delete: if false;
    }

    // ───────────── Codici d'invito ─────────────
    // invites/{codice} → { classId, nomeClasse }
    // Si può leggere un codice che si conosce (get), mai elencarli tutti (list).

    match /invites/{codice} {
      allow get: if isScuola();
      allow list: if false;

      allow create: if isScuola() && codiceValido(codice)
        && request.resource.data.keys().hasOnly(['classId', 'nomeClasse'])
        && getAfter(classePath(request.resource.data.classId)).data.capoclasseUid == request.auth.uid
        && getAfter(classePath(request.resource.data.classId)).data.codiceInvito == codice
        && request.resource.data.nomeClasse == getAfter(classePath(request.resource.data.classId)).data.nome;

      // Solo per aggiornare il nome quando il capoclasse rinomina la classe.
      allow update: if isCapo(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nomeClasse'])
        && request.resource.data.nomeClasse == getAfter(classePath(resource.data.classId)).data.nome;

      // Quando il codice della classe viene sostituito da uno nuovo, o la classe viene eliminata.
      allow delete: if isCapo(resource.data.classId)
        && (
          !existsAfter(classePath(resource.data.classId))
          || getAfter(classePath(resource.data.classId)).data.codiceInvito != codice
        );
    }

    // ───────────── Classi ─────────────

    match /classes/{c} {
      allow read: if isMembro(c);

      // Solo gli studenti creano classi. Nello stesso batch vanno creati
      // il proprio documento membro (ruolo capo) e il codice d'invito.
      allow create: if isStudente()
        && request.resource.data.keys().hasOnly(['nome', 'codiceInvito', 'capoclasseUid', 'creato'])
        && testo(request.resource.data.nome, 60)
        && request.resource.data.capoclasseUid == request.auth.uid
        && codiceValido(request.resource.data.codiceInvito)
        && request.resource.data.creato == request.time
        && getAfter(membroPath(c, request.auth.uid)).data.ruolo == 'capo'
        && getAfter(invitoPath(request.resource.data.codiceInvito)).data.classId == c;

      // Il capoclasse può rinominare la classe o cambiare il codice d'invito.
      // Se cambia il codice, nello stesso batch crea il nuovo e cancella il vecchio.
      allow update: if isCapo(c) && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'codiceInvito'])
          && testo(request.resource.data.nome, 60)
          && codiceValido(request.resource.data.codiceInvito)
          && (
            request.resource.data.codiceInvito == resource.data.codiceInvito
            || (
              getAfter(invitoPath(request.resource.data.codiceInvito)).data.classId == c
              && !existsAfter(invitoPath(resource.data.codiceInvito))
            )
          )
        )
        ||
        // Il capoclasse cede il ruolo a uno studente (o al vice): nello stesso batch
        // il nuovo diventa "capo" e lui torna vice o studente. Mai due capi, mai un docente.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capoclasseUid'])
          && request.resource.data.capoclasseUid != request.auth.uid
          && get(membroPath(c, request.resource.data.capoclasseUid)).data.ruolo in ['studente', 'vice']
          && getAfter(membroPath(c, request.resource.data.capoclasseUid)).data.ruolo == 'capo'
          && getAfter(membroPath(c, request.auth.uid)).data.ruolo in ['vice', 'studente']
        )
      );

      // Solo il capoclasse, e nello stesso batch spariscono anche il codice d'invito e il suo documento membro
      // (il sito cancella insieme anche gli altri membri, materie, calendario e badge).
      allow delete: if isCapo(c)
        && !existsAfter(invitoPath(resource.data.codiceInvito))
        && !existsAfter(membroPath(c, request.auth.uid));

      // ───── Membri ─────
      // members/{uid} → { uid, nome, email, foto, ruolo, permessoModifica, richiestaPermesso, codiceUsato, entrato }
      // ruolo: capo | vice | studente | docente

      match /members/{u} {
        allow read: if isMembro(c);
        // Il proprio documento si può sempre leggere, anche se non esiste ancora (per sapere se si è già iscritti).
        allow get: if isScuola() && u == request.auth.uid;

        allow create: if isScuola() && u == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'foto', 'ruolo', 'permessoModifica', 'richiestaPermesso', 'codiceUsato', 'entrato', 'rifiutaScambi'])
          && request.resource.data.get('rifiutaScambi', false) is bool
          && request.resource.data.uid == u
          && testo(request.resource.data.nome, 100)
          && request.resource.data.email == request.auth.token.email
          && fotoValida(request.resource.data.get('foto', null))
          && request.resource.data.permessoModifica == false
          && request.resource.data.richiestaPermesso == false
          && codiceValido(request.resource.data.codiceUsato)
          && request.resource.data.entrato == request.time
          && (
            // Il capoclasse mentre crea la classe
            (
              request.resource.data.ruolo == 'capo'
              && !exists(classePath(c))
              && getAfter(classePath(c)).data.capoclasseUid == u
            )
            ||
            // Chiunque della scuola con un codice d'invito valido: entra come studente o docente
            (
              request.resource.data.ruolo == tipoAccount()
              && exists(classePath(c))
              && get(invitoPath(request.resource.data.codiceUsato)).data.classId == c
            )
          );

        allow update: if isMembro(c) && (
          // Sé stessi: nome e foto; i docenti anche la richiesta di permesso
          (
            u == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'foto', 'richiestaPermesso', 'rifiutaScambi'])
            && testo(request.resource.data.nome, 100)
            && fotoValida(request.resource.data.get('foto', null))
            && request.resource.data.get('rifiutaScambi', false) is bool
            && (
              request.resource.data.richiestaPermesso == resource.data.richiestaPermesso
              || (resource.data.ruolo == 'docente' && request.resource.data.richiestaPermesso is bool && resource.data.permessoModifica == false)
            )
          )
          ||
          // Il capoclasse che cede il ruolo: il proprio documento torna vice o studente
          (
            u == request.auth.uid
            && isCapo(c)
            && resource.data.ruolo == 'capo'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruolo'])
            && request.resource.data.ruolo in ['vice', 'studente']
            && getAfter(classePath(c)).data.capoclasseUid != request.auth.uid
          )
          ||
          // Il capoclasse sugli altri: nomina o toglie il vice, dà o toglie il permesso ai docenti,
          // oppure (cedendo il ruolo) nomina il nuovo capoclasse
          (
            isCapo(c) && u != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ruolo', 'permessoModifica', 'richiestaPermesso'])
            && (
              (
                resource.data.ruolo in ['studente', 'vice']
                && request.resource.data.ruolo == 'capo'
                && getAfter(classePath(c)).data.capoclasseUid == u
                && request.resource.data.permessoModifica == false
                && request.resource.data.richiestaPermesso == false
              )
              ||
              (
                resource.data.ruolo in ['studente', 'vice']
                && request.resource.data.ruolo in ['studente', 'vice']
                && request.resource.data.permessoModifica == false
                && request.resource.data.richiestaPermesso == false
              )
              ||
              (
                resource.data.ruolo == 'docente'
                && request.resource.data.ruolo == 'docente'
                && request.resource.data.permessoModifica is bool
                && request.resource.data.richiestaPermesso == false
              )
            )
          )
        );

        // Si esce da soli, oppure il capoclasse rimuove. Il capoclasse non può uscire,
        // ma i documenti di tutti (il suo compreso) spariscono quando elimina la classe.
        allow delete: if (isMembro(c) && resource.data.ruolo != 'capo' && (u == request.auth.uid || isCapo(c)))
          || eliminazioneClasse(c);
      }

      // ───── Badge DSA/BES ─────
      // dsa/{uid} esiste se lo studente ha il badge. Lo vedono solo capo, vice e il diretto interessato.

      match /dsa/{u} {
        allow read: if isMembro(c) && (u == request.auth.uid || mioRuolo(c) in ['capo', 'vice']);
        allow create: if isCapoOVice(c)
          && get(membroPath(c, u)).data.ruolo in ['capo', 'vice', 'studente']
          && request.resource.data.keys().hasOnly(['impostatoDa', 'quando'])
          && request.resource.data.impostatoDa == request.auth.uid
          && request.resource.data.quando == request.time;
        allow update: if false;
        // Capo e vice tolgono il badge; il diretto interessato può toglierlo a sé stesso (ad esempio uscendo dalla classe).
        allow delete: if isCapoOVice(c) || (isMembro(c) && u == request.auth.uid);
      }

      // ───── Calendario ─────
      // calendar/settings → { giorniScolastici[7], eccezioni[], fineAnno, aggiornato }
      // Le singole eccezioni le controlla il sito: le regole non possono scorrere le liste.

      match /calendar/{documento} {
        allow read: if isMembro(c);
        allow create, update: if isCapoOVice(c) && documento == 'settings'
          && request.resource.data.keys().hasOnly(['giorniScolastici', 'eccezioni', 'fineAnno', 'aggiornato'])
          && request.resource.data.giorniScolastici is list && request.resource.data.giorniScolastici.size() == 7
          && request.resource.data.eccezioni is list && request.resource.data.eccezioni.size() <= 300
          && dataISO(request.resource.data.fineAnno)
          && request.resource.data.aggiornato == request.time;
        allow delete: if eliminazioneClasse(c);
      }

      // ───── Materie e interrogazioni ─────

      match /subjects/{s} {
        allow read: if isMembro(c);
        allow create, update: if isCapoOVice(c)
          && request.resource.data.keys().hasOnly(['nome', 'orario', 'creato'])
          && testo(request.resource.data.nome, 40)
          && giorniLezione(request.resource.data.orario)
          && request.resource.data.creato is timestamp;
        allow delete: if isCapoOVice(c);

        // interrogations/{i} → { nome, descrizione, giorni, perLezione, scadenzaPreferenze, stato, creato, creatoDa, aggiornato }
        match /interrogations/{i} {
          function interrogazioneValida(d) {
            return d.keys().hasOnly(['nome', 'descrizione', 'giorni', 'perLezione', 'scadenzaPreferenze', 'stato', 'creato', 'creatoDa', 'aggiornato'])
              && testo(d.nome, 60)
              && d.descrizione is string && d.descrizione.size() <= 500
              && giorniLezione(d.giorni)
              && (d.perLezione == null || (d.perLezione is int && d.perLezione >= 1 && d.perLezione <= 50))
              && d.scadenzaPreferenze is timestamp
              && d.aggiornato == request.time;
          }

          allow read: if isMembro(c);
          allow create: if isCapoOVice(c)
            && exists(/databases/$(database)/documents/classes/$(c)/subjects/$(s))
            && interrogazioneValida(request.resource.data)
            && request.resource.data.stato == 'raccolta'
            && request.resource.data.creato == request.time
            && request.resource.data.creatoDa == request.auth.uid;
          allow update: if (
              // Tutti interrogati (o non più): lista ↔ conclusa, anche per i docenti con permesso
              puoModificareListe(c)
              && interrogazioneValida(request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'aggiornato'])
              && resource.data.stato in ['lista', 'conclusa']
              && request.resource.data.stato in ['lista', 'conclusa']
              && (
                request.resource.data.stato == 'conclusa'
              ) == (
                getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.interrogati.size()
                == getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.ordine.size()
              )
            ) || (
              isCapoOVice(c)
              && interrogazioneValida(request.resource.data)
              && (
              // Modifica dei dati
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'descrizione', 'giorni', 'perLezione', 'scadenzaPreferenze', 'aggiornato'])
              ||
              // Generazione della lista: solo dopo la scadenza, e nello stesso batch va scritta la lista
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'aggiornato'])
                && resource.data.stato == 'raccolta'
                && request.resource.data.stato == 'lista'
                && request.time >= resource.data.scadenzaPreferenze
                && existsAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current)
              )
              )
            );
          allow delete: if isCapoOVice(c);

          // ───── Preferenze ─────
          // preferences/{uid} → { scelta, posizioneDSA, aggiornato }
          // Ognuno vede la propria; capo e vice le vedono tutte (servono per generare la lista).

          match /preferences/{u} {
            function aperta() {
              return get(interrogazionePath(c, s, i)).data.stato == 'raccolta'
                && request.time < get(interrogazionePath(c, s, i)).data.scadenzaPreferenze;
            }

            allow get: if isMembro(c) && (u == request.auth.uid || isCapoOVice(c));
            allow list: if isCapoOVice(c);
            allow create, update: if isMembro(c) && u == request.auth.uid
              && mioRuolo(c) in ['capo', 'vice', 'studente']
              && aperta()
              && request.resource.data.keys().hasOnly(['scelta', 'posizioneDSA', 'aggiornato'])
              && request.resource.data.aggiornato == request.time
              && (
                (request.resource.data.scelta in ['inizio', 'meta', 'fine', 'indifferente'] && request.resource.data.posizioneDSA == null)
                || (
                  request.resource.data.scelta == 'posizione'
                  && request.resource.data.posizioneDSA is int
                  && request.resource.data.posizioneDSA >= 1 && request.resource.data.posizioneDSA <= 200
                  && exists(dsaPath(c, u))
                )
              );
            allow delete: if (isMembro(c) && u == request.auth.uid && aperta())
              || (isCapoOVice(c) && !existsAfter(interrogazionePath(c, s, i)));
          }

          // ───── Lista ─────
          // list/current → { ordine[uid], interrogati{uid: data}, generata, generataDa } (la vedono tutti)
          // list/rapporto → rapporto di soddisfazione (solo capo e vice)

          match /list/{documento} {
            allow read: if isMembro(c) && (documento == 'current' || isCapoOVice(c));
            allow create: if isCapoOVice(c)
              && getAfter(interrogazionePath(c, s, i)).data.stato == 'lista'
              && get(interrogazionePath(c, s, i)).data.stato == 'raccolta'
              && (
                (
                  documento == 'current'
                  && request.resource.data.keys().hasOnly(['ordine', 'interrogati', 'generata', 'generataDa', 'ultimaModifica'])
                  && voceStoricoNuova(request.resource.data.get('ultimaModifica', null))
                  && request.resource.data.ordine is list && request.resource.data.ordine.size() <= 200
                  && request.resource.data.interrogati is map && request.resource.data.interrogati.size() == 0
                  && request.resource.data.generata == request.time
                  && request.resource.data.generataDa == request.auth.uid
                )
                || (documento == 'rapporto' && request.resource.data.generata == request.time)
              );
            // Riordino e interrogati: stesse persone, interrogati solo tra chi è in lista
            allow update: if puoModificareListe(c) && documento == 'current'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordine', 'interrogati', 'aggiornato', 'aggiornatoDa', 'ultimaModifica'])
              // ogni modifica lascia una voce nuova nello storico, scritta nello stesso batch
              && request.resource.data.get('ultimaModifica', null) != resource.data.get('ultimaModifica', null)
              && voceStoricoNuova(request.resource.data.get('ultimaModifica', null))
              && request.resource.data.aggiornato == request.time
              && request.resource.data.aggiornatoDa == request.auth.uid
              && request.resource.data.ordine is list
              && request.resource.data.ordine.size() == resource.data.ordine.size()
              && request.resource.data.ordine.toSet() == resource.data.ordine.toSet()
              && request.resource.data.interrogati is map
              && request.resource.data.ordine.toSet().hasAll(request.resource.data.interrogati.keys());
            // Scambio: chi riceve la richiesta la accetta e scambia SOLO le due posizioni
            allow update: if documento == 'current' && isMembro(c) && scambioAccettato();
            allow delete: if isCapoOVice(c) && !existsAfter(interrogazionePath(c, s, i));

            function scambioAccettato() {
              let id = request.resource.data.get('scambio', null);
              let io = request.auth.uid;
              let vecchio = resource.data.ordine;
              let nuovo = request.resource.data.ordine;
              return id is string
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordine', 'scambio', 'ultimaModifica', 'aggiornato', 'aggiornatoDa'])
                && request.resource.data.get('ultimaModifica', null) != resource.data.get('ultimaModifica', null)
                && voceStoricoNuova(request.resource.data.get('ultimaModifica', null))
                && request.resource.data.aggiornato == request.time
                && request.resource.data.aggiornatoDa == io
                && get(interrogazionePath(c, s, i)).data.stato == 'lista'
                && scambioCoerente(get(scambioPath(id)).data, getAfter(scambioPath(id)).data, io, vecchio, nuovo);
            }

            function scambioCoerente(prima, dopo, io, vecchio, nuovo) {
              return prima.stato == 'attesa' && dopo.stato == 'accettato'
                && vecchio[prima.daPos] == prima.da && vecchio[prima.aPos] == io
                && nuovo is list && nuovo.size() == vecchio.size()
                && nuovo[prima.daPos] == io && nuovo[prima.aPos] == prima.da
                // tutti gli altri restano dove sono
                && nuovo.removeAll([io, prima.da]) == vecchio.removeAll([io, prima.da])
                && !(io in resource.data.interrogati) && !(prima.da in resource.data.interrogati);
            }
          }

          function scambioPath(id) {
            return /databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/scambi/$(id);
          }
          // In questo batch la richiesta id passa da "attesa" ad "accettato"
          function scambioInCorso(id) {
            return id is string && id != ''
              && get(scambioPath(id)).data.stato == 'attesa'
              && getAfter(scambioPath(id)).data.stato == 'accettato';
          }

          // ───── Storico delle modifiche alla lista ─────
          // storico/{id} → { tipo, chi, quando, dettagli }: lo vedono tutti, non si modifica mai.

          function voceStoricoNuova(id) {
            return id is string
              && !exists(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/storico/$(id))
              && existsAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/storico/$(id));
          }

          match /storico/{voce} {
            allow read: if isMembro(c);
            allow create: if puoModificareListe(c)
              && request.resource.data.keys().hasOnly(['tipo', 'chi', 'quando', 'dettagli'])
              && request.resource.data.tipo in ['generata', 'riordino', 'interrogati', 'annullato']
              && request.resource.data.chi == request.auth.uid
              && request.resource.data.quando == request.time
              && request.resource.data.dettagli is map
              // la voce va insieme a una modifica della lista che la indica
              && getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.get('ultimaModifica', null) == voce;
            // Scambio accettato: la voce va insieme alla lista con il nuovo "scambio"
            allow create: if isMembro(c)
              && request.resource.data.keys().hasOnly(['tipo', 'chi', 'quando', 'dettagli'])
              && request.resource.data.tipo == 'scambio'
              && request.resource.data.chi == request.auth.uid
              && request.resource.data.quando == request.time
              && request.resource.data.dettagli is map
              && getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.get('ultimaModifica', null) == voce
              && scambioInCorso(getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.get('scambio', ''));
            allow update: if false;
            allow delete: if isCapoOVice(c) && !existsAfter(interrogazionePath(c, s, i));
          }

          // ───── Scambi ─────
          // scambi/{da}_0 → { da, daPos, aPos, stato, creato, aggiornato, a }
          // "da" (in posizione daPos) chiede la posizione aPos: decide chi la occupa ADESSO
          // (la richiesta segue la posizione). Una sola richiesta aperta a testa: il documento è {da}_0.
          // Le vedono solo chi chiede, chi occupa la posizione richiesta, capo e vice.

          match /scambi/{id} {
            function lista() {
              return get(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data;
            }
            function destinatario() {
              return lista().ordine[resource.data.aPos];
            }
            function nuovaRichiesta(d) {
              let l = lista();
              return d.keys().hasOnly(['da', 'daPos', 'aPos', 'stato', 'creato', 'aggiornato', 'a'])
                && d.da == request.auth.uid
                && id == d.da + '_0'
                && d.stato == 'attesa'
                && d.creato == request.time
                && d.aggiornato == request.time
                && d.a == null
                && d.daPos is int && d.aPos is int && d.daPos != d.aPos
                && d.daPos >= 0 && d.aPos >= 0
                && d.daPos < l.ordine.size() && d.aPos < l.ordine.size()
                && l.ordine[d.daPos] == request.auth.uid
                && !(request.auth.uid in l.interrogati)
                && !(l.ordine[d.aPos] in l.interrogati)
                && get(interrogazionePath(c, s, i)).data.stato == 'lista'
                && get(membroPath(c, l.ordine[d.aPos])).data.get('rifiutaScambi', false) != true;
            }
            function risposta(stato) {
              return resource.data.stato == 'attesa'
                && request.resource.data.stato == stato
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'aggiornato', 'a'])
                && request.resource.data.aggiornato == request.time;
            }

            allow read: if isMembro(c) && (
              resource.data.da == request.auth.uid
              || resource.data.get('a', null) == request.auth.uid
              || isCapoOVice(c)
              || (resource.data.stato == 'attesa' && destinatario() == request.auth.uid)
            );
            allow create: if isMembro(c) && nuovaRichiesta(request.resource.data);
            allow update: if isMembro(c) && (
              // un posto libero (richiesta chiusa) si riusa per una richiesta nuova
              (resource.data.stato != 'attesa' && nuovaRichiesta(request.resource.data))
              // chi ha chiesto (o capo e vice) annulla
              || (
                (resource.data.da == request.auth.uid || isCapoOVice(c))
                && risposta('annullato') && request.resource.data.a == resource.data.a
              )
              // chi occupa la posizione richiesta rifiuta…
              || (destinatario() == request.auth.uid && risposta('rifiutato') && request.resource.data.a == request.auth.uid)
              // …o accetta, scambiando le posizioni nello stesso batch
              || (
                destinatario() == request.auth.uid && risposta('accettato') && request.resource.data.a == request.auth.uid
                // la lista cambia nello stesso batch e indica proprio questa richiesta
                && getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.get('scambio', null) == id
                && getAfter(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data.get('ultimaModifica', null)
                  != lista().get('ultimaModifica', null)
              )
            );
            allow delete: if isCapoOVice(c) && !existsAfter(interrogazionePath(c, s, i));
          }

          // ───── "Sono stato interrogato" ─────
          // segnalazioni/{uid} → { data, quando }: lo studente lo segnala, chi modifica le liste conferma.

          match /segnalazioni/{u} {
            function lista() {
              return get(/databases/$(database)/documents/classes/$(c)/subjects/$(s)/interrogations/$(i)/list/current).data;
            }
            allow get: if isMembro(c) && (u == request.auth.uid || puoModificareListe(c));
            allow list: if puoModificareListe(c);
            allow create: if isMembro(c) && u == request.auth.uid
              && u in lista().ordine
              && !(u in lista().interrogati)
              && request.resource.data.keys().hasOnly(['data', 'quando'])
              && dataISO(request.resource.data.data)
              && request.resource.data.quando == request.time;
            allow update: if false;
            allow delete: if (isMembro(c) && u == request.auth.uid) || puoModificareListe(c);
          }
        }
      }
    }

    // ───────────── Le mie classi (query su tutti i "members") ─────────────

    match /{percorso=**}/members/{u} {
      allow read: if isScuola() && resource.data.uid == request.auth.uid;
    }
  }
}
